# Copia este archivo a ".env" y completa tus valores reales.
# NUNCA subas el archivo ".env" a un repositorio público.

PORT=4000

# Dominio real de tu sitio (para CORS). En desarrollo local puedes
# dejar http://localhost:5500 o el puerto que uses para servir el frontend.
SITE_ORIGIN=https://umbralvr.cl

# URL pública de este backend y de tu frontend (para las redirecciones
# de Transbank y los links de los correos).
BACKEND_PUBLIC_URL=https://api.umbralvr.cl
FRONTEND_URL=https://umbralvr.cl

# ---- Reglas del negocio ----
PRICE_PER_PLAYER_CLP=12000

# ---- Transbank Webpay Plus ----
# Deja "integration" mientras pruebas — no requiere credenciales reales.
# Cuando Transbank apruebe tu afiliación como comercio, cambia a
# "production" y pega el CommerceCode y ApiKey que ellos te entreguen.
TBK_ENV=integration
TBK_COMMERCE_CODE=
TBK_API_KEY=

# ---- Correo (SMTP) ----
# Sirve cualquier proveedor SMTP: Zoho Mail, Gmail Workspace, Brevo,
# Resend, Amazon SES, etc. Ejemplo con Zoho:
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=reservas@umbralvr.cl
SMTP_PASS=
FROM_EMAIL=reservas@umbralvr.cl
FROM_NAME=Umbral VR

# Ruta del archivo de base de datos SQLite (opcional, tiene un default).
# DB_PATH=./db/umbral-vr.sqlite3
